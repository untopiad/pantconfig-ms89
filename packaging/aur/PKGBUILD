# Maintainer: PanteonConfig contributors <p4650@users.noreply.gitlab.com>
pkgname=panteon-ms89
pkgver=0.1.1
pkgrel=1
pkgdesc="Linux userspace configurator for the PANTEON MS89 gaming mouse"
arch=('x86_64')
url="https://github.com/EvgeniyGRep/pantconfig-ms89"
license=('MIT')
depends=('gcc-libs' 'glibc' 'libx11' 'libxcb' 'libxkbcommon' 'wayland' 'mesa')
makedepends=('cargo' 'rust')
install="${pkgname}.install"
source=("git+${url}.git#tag=v${pkgver}")
sha256sums=('SKIP')

build() {
    cd "${srcdir}/pantconfig"
    cargo build --release --locked --features gui --bins \
        --manifest-path panteon-ms89/Cargo.toml
}

package() {
    cd "${srcdir}/pantconfig"

    install -Dm755 panteon-ms89/target/release/panteon-ms89 \
        "${pkgdir}/usr/bin/panteon-ms89"
    install -Dm755 panteon-ms89/target/release/panteon-gui \
        "${pkgdir}/usr/bin/panteon-gui"

    install -Dm644 panteon-ms89/udev/99-panteon-ms89.rules \
        "${pkgdir}/usr/lib/udev/rules.d/99-panteon-ms89.rules"
    install -Dm644 assets/io.gitlab.p4650.pantconfig.desktop \
        "${pkgdir}/usr/share/applications/io.gitlab.p4650.pantconfig.desktop"
    install -Dm644 assets/io.gitlab.p4650.pantconfig.svg \
        "${pkgdir}/usr/share/icons/hicolor/scalable/apps/io.gitlab.p4650.pantconfig.svg"
    install -Dm644 assets/io.gitlab.p4650.pantconfig.metainfo.xml \
        "${pkgdir}/usr/share/metainfo/io.gitlab.p4650.pantconfig.metainfo.xml"

    install -Dm644 panteon-ms89/LICENSE \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 panteon-ms89/THIRD-PARTY-NOTICES.md \
        "${pkgdir}/usr/share/licenses/${pkgname}/THIRD-PARTY-NOTICES.md"
}